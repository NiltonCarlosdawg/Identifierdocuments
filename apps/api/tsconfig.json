{
  "compilerOptions": {"allowSyntheticDefaultImports": true, "moduleResolution": "node",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "types": ["bun-types", "elysia"]
  },
  "include": ["src/**/*"]
}
