PORT=3000
NODE_ENV=development

DATABASE_URL=postgresql://user:pass@localhost:5432/docid

REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m

UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

GROQ_API_KEY=

SSE_HEARTBEAT_MS=30000

RATE_LIMIT_MAX=5

# Onboarding: em produção deixe ALLOW_PUBLIC_ONBOARDING=false e use ONBOARDING_SECRET
ALLOW_PUBLIC_ONBOARDING=true
ONBOARDING_SECRET=

# Swagger em /docs — em production fica off salvo ENABLE_SWAGGER=true
ENABLE_SWAGGER=true

BULLMQ_ENABLED=true
