PORT=3000
NODE_ENV=development

DATABASE_URL=postgresql://user:pass@localhost:5432/docid

REDIS_URL=redis://localhost:6379
# Em produção (alojamento partilhado): caminho absoluto do socket, ex.
# REDIS_URL=/mnt/homer2/milvendas/didall.milvendas.ao/redis/redis.sock (scripts/redis.sh arranca-o)
# REDIS_PASSWORD=<openssl rand -hex 24>

# Obrigatório: pelo menos 32 caracteres aleatórios (ex.: openssl rand -base64 48). Em produção a API recusa arrancar com um valor fraco.
JWT_SECRET=
# Duração máxima de uma sessão sem novo login com password (horas)
SESSION_MAX_AGE_HOURS=168
JWT_EXPIRES_IN=15m

UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# Fornecedor de IA (classificador de documentos), API compatível com OpenAI.
KAMBA_AI_API_KEY=
KAMBA_AI_BASE_URL=https://api.groq.com/openai/v1
KAMBA_AI_MODEL=openai/gpt-oss-120b
# Nome antigo da chave, ainda aceite se KAMBA_AI_API_KEY não estiver definida.
GROQ_API_KEY=

SSE_HEARTBEAT_MS=30000

RATE_LIMIT_MAX=5

# Nº de proxies à frente da API (LiteSpeed do cPanel = 1). Usado para ler o IP real do cliente.
TRUSTED_PROXY_HOPS=1

# Onboarding: em produção deixe ALLOW_PUBLIC_ONBOARDING=false e use ONBOARDING_SECRET
ALLOW_PUBLIC_ONBOARDING=false
ONBOARDING_SECRET=

# Recusa arrancar se o utilizador da BD ignorar o RLS (superutilizador ou BYPASSRLS). Ver docs/RLS_PRODUCAO.md
REQUIRE_RLS_ROLE=false

# Fuso usado na data dos identificadores (ANO-MMDD). Por omissão Africa/Luanda.
IDENTIFIER_TIMEZONE=Africa/Luanda

# Swagger em /docs — em production fica off salvo ENABLE_SWAGGER=true
ENABLE_SWAGGER=false

BULLMQ_ENABLED=true

# Painel do provedor: alertas/order emails e base do link de checkout
PROVIDER_NOTIFY_EMAIL=provedor@exemplo.ao
LANDING_URL=https://docid.milvendas.ao
# ── Notificações por e-mail (ver docs/NOTIFICACOES_EMAIL.md) ──
# Chave que encripta as credenciais SMTP / chaves de API dos tenants (32 bytes em base64).
# Gerar com: openssl rand -base64 32   — guardar fora da BD; perdê-la obriga a reconfigurar o e-mail dos tenants.
EMAIL_SECRETS_KEY=
# Segredo dos links de download enviados por e-mail (se vazio usa JWT_SECRET).
EMAIL_LINK_SECRET=
EMAIL_LINK_TTL_HOURS=72
# URL pública da API usada nos links dos e-mails.
PUBLIC_API_URL=https://didall.milvendas.ao
# Sem configuração própria do tenant: "platform" (envia pelo SMTP abaixo, "Empresa via DocID") ou "block" (não envia).
EMAIL_FALLBACK_MODE=platform
EMAIL_NOTIFICATIONS_ENABLED=true
EMAIL_WORKER_ENABLED=true
EMAIL_WORKER_INTERVAL_MS=10000
EMAIL_TIMEZONE=Africa/Luanda
# Só em desenvolvimento (ex.: MailHog local). Nunca ligar em produção: desliga a protecção SSRF.
EMAIL_ALLOW_PRIVATE_SMTP=false

# SMTP da plataforma (fallback e e-mails de convite / reposição de password)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DocID <no-reply@milvendas.ao>"

# Licenças das organizações
PLATFORM_ADMIN_TOKEN=
LICENSE_TRIAL_DAYS=14
LICENSE_TRIAL_MAX_USERS=5
LICENSE_GRACE_DAYS=7
LICENSE_SUPPORT_CONTACT=o suporte DocID
