<?xml version="1.0" encoding="utf-8"?>
<!-- POC: empacotamento MSIX (full-trust Win32) para sideload e futura submissão à Microsoft Store.
     Identity/Publisher de exemplo: na Store têm de coincidir com os valores de
     Partner Center > Product management > View app identity details. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="MilVendas.DocID"
    Publisher="CN=MilVendas"
    Version="1.1.6.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>DocID</DisplayName>
    <PublisherDisplayName>MilVendas</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="pt-PT" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="DocID" Executable="DocID.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="DocID"
        Description="Identificador único para cada documento."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
