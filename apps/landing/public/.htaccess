# cPanel/Apache serving for docid.milvendas.ao
AddDefaultCharset utf-8

<IfModule mod_headers.c>
  # Hashed bundles and font files never change under the same name.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|ico|svg)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Cabeçalhos de segurança (aplicam-se também a /admin/ e /downloads/).
<IfModule mod_headers.c>
  # Só HTTPS durante um ano (sem preload: é difícil de desfazer).
  Header always set Strict-Transport-Security "max-age=31536000"
  # Ninguém pode meter o site dentro de outra página (protecção contra páginas falsas).
  Header always set X-Frame-Options "DENY"
  Header always set Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
</IfModule>
